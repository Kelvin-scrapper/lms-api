PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/summertech_lms?schema=public

# At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# The LMS frontend. Sign-in links in emails point here.
APP_URL=http://localhost:3001
# Comma-separated CORS origins allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:3001

# Number of reverse proxies in front of the API (e.g. 1). Set this behind
# nginx/Traefik/a load balancer, or rate limits treat all users as one client.
# TRUST_PROXY=1

# Email for magic links (Resend). Without a key, emails are printed to the log.
# RESEND_API_KEY=
# EMAIL_FROM=Summertech <login@summertech.ac.ke>

# File uploads. With BLOB_READ_WRITE_TOKEN, files go to Vercel Blob (works with
# any number of API instances). Without it they're saved to UPLOAD_DIR and
# served at API_PUBLIC_URL/files/... (one server with a persistent volume).
# BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR=./uploads
API_PUBLIC_URL=http://localhost:4000
# MAX_UPLOAD_MB=200

# Demo accounts are created on start unless NODE_ENV=production.
# NODE_ENV=production
# Optional recovery: create (or reset the password of) this admin on every start.
# SEED_ADMIN_EMAIL=admin@summertech.ac.ke
# SEED_ADMIN_NAME=Site Admin
# SEED_ADMIN_PASSWORD=choose-a-strong-password

# Used by docker-compose.yml.
POSTGRES_PASSWORD=change-this-to-a-long-random-string
POSTGRES_DB=summertech_lms

# Tests (npm test) create a temporary schema in this database and drop it when
# done; existing tables are left alone. Use a development database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/summertech_lms_test
